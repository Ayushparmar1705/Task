{
  "projectType": "webapp",
  "setup": [
    {
      "command": "npm",
      "args": ["ci"]
    }
  ],
  "assertions": [
    {
      "name": "production-build",
      "kind": "process",
      "command": "npm",
      "args": ["run", "build"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "npm",
      "args": ["test"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "home-route-serves",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "dev", "--", "--host", "127.0.0.1", "--strictPort"],
      "url": "http://127.0.0.1:5173/",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    },
    {
      "name": "article-route-serves",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "dev", "--", "--host", "127.0.0.1", "--strictPort"],
      "url": "http://127.0.0.1:5173/eco-friendly-habits-small-changes-for-a-greener-life/",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    },
    {
      "name": "about-route-serves",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "dev", "--", "--host", "127.0.0.1", "--strictPort"],
      "url": "http://127.0.0.1:5173/about/",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    }
  ]
}
